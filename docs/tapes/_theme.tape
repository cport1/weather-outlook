# Shared terminal look for all README recordings (matches the app's midnight theme).
Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 14
Set LineHeight 1.05
Set Width 1400
Set Height 820
Set Padding 18
Set WindowBar Colorful
Set BorderRadius 10
Set Margin 0
Set Theme { "name": "wxo", "background": "#0a0f16", "foreground": "#e6edf3", "black": "#0a0f16", "brightBlack": "#3a4756", "red": "#ff5252", "brightRed": "#ff8a80", "green": "#69f0ae", "brightGreen": "#b9f6ca", "yellow": "#ffd54f", "brightYellow": "#ffe57f", "blue": "#7dd3fc", "brightBlue": "#bae6fd", "magenta": "#c4b5fd", "brightMagenta": "#ddd6fe", "cyan": "#4dd0e1", "brightCyan": "#a5f3fc", "white": "#e6edf3", "brightWhite": "#ffffff", "cursor": "#7dd3fc", "selection": "#223041" }
Set TypingSpeed 40ms
