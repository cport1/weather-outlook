{
  "name": "weather-outlook",
  "version": "2.0.0-alpha.1",
  "description": "A ridiculously good terminal weather dashboard: forecasts, radar, alerts, hurricanes, wildfires and quakes on a live world map.",
  "type": "module",
  "bin": {
    "weather-outlook": "./bin/weather-outlook.js",
    "wo": "./bin/weather-outlook.js"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "bun scripts/build.ts",
    "schema": "bun scripts/gen-schema.ts",
    "fixtures": "bun scripts/record-fixtures.ts",
    "compile": "bun scripts/compile.ts",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cport1/weather-outlook.git"
  },
  "keywords": [
    "weather",
    "forecast",
    "cli",
    "tui",
    "radar",
    "hurricane",
    "wildfire",
    "earthquake",
    "terminal",
    "dashboard"
  ],
  "author": "Chris Portscheller",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cport1/weather-outlook/issues"
  },
  "homepage": "https://github.com/cport1/weather-outlook#readme",
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@opentui/core": "0.5.16",
    "@opentui/solid": "0.5.16",
    "chalk": "6.0.1",
    "citty": "0.2.2",
    "d3-geo": "3.1.1",
    "env-paths": "4.0.0",
    "solid-js": "1.9.12",
    "suncalc": "^2.1.1",
    "topojson-client": "3.1.0",
    "us-atlas": "3.0.1",
    "world-atlas": "2.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/suncalc": "^1.9.2",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "7.0.2"
  },
  "files": [
    "bin",
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
