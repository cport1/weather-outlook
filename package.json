{
  "name": "weather-outlook",
  "version": "2.0.0-alpha.0",
  "description": "A ridiculously good terminal weather dashboard: forecasts, radar, alerts, hurricanes, wildfires and quakes on a live world map.",
  "type": "module",
  "bin": {
    "weather-outlook": "./src/cli.ts",
    "wo": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cport1/weather-outlook.git"
  },
  "keywords": [
    "weather",
    "forecast",
    "cli",
    "tui",
    "radar",
    "hurricane",
    "wildfire",
    "earthquake",
    "terminal",
    "dashboard"
  ],
  "author": "Chris Portscheller",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cport1/weather-outlook/issues"
  },
  "homepage": "https://github.com/cport1/weather-outlook#readme",
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "chalk": "6.0.1",
    "commander": "15.0.0",
    "d3-geo": "3.1.1",
    "env-paths": "4.0.0",
    "suncalc": "^2.1.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/suncalc": "^1.9.2",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "7.0.2"
  }
}
